{
  "name": "top-cloud-staff-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src scripts",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'scripts/**/*.ts' 'tests/**/*.ts' '*.{json,ts,mjs}' README.md",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'scripts/**/*.ts' 'tests/**/*.ts' '*.{json,ts,mjs}' README.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:all": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "db:migrate": "tsx scripts/migrate.ts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "account:reset": "tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/node": "22.19.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.2",
    "eslint": "10.13.0",
    "prettier": "^3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
